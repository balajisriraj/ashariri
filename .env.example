# Claude (default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ASHARIRI_LLM=anthropic
ASHARIRI_MODEL=claude-opus-5-5

# Run with no API key: a deterministic model that answers extractively from the sources.
# ASHARIRI_LLM=scripted
# ASHARIRI_SCRIPTED_DELAY=0.04

# Storage: sqlite (single file, default) or postgres (pgvector)
# ASHARIRI_STORE=postgres
# ASHARIRI_POSTGRES_DSN=postgresql://ashariri:ashariri@localhost:5432/ashariri
